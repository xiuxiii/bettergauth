# ---------------------------------------------------------------------------
# AI provider configuration
#
# Keys are ONLY ever read server-side (in lib/ai/*, all `server-only`) and are
# never exposed to the client. Copy this file to `.env.local` and fill it in.
#
# Provider selection:
#   - Set ANTHROPIC_API_KEY below and the app uses the real Claude vision model
#     automatically (no other change needed).
#   - With no key set, it falls back to the offline mock.
#   - Set AI_PROVIDER explicitly ("anthropic" or "mock") to override that.
# ---------------------------------------------------------------------------

# Your Anthropic API key (starts with sk-ant-...). Server-side only.
# Setting this is all it takes to switch from the mock to the real model.
ANTHROPIC_API_KEY=sk-ant-api03-G-B...lAAA

# Optional: pin the provider explicitly. Leave unset to auto-detect from the key.
# AI_PROVIDER=anthropic

# Optional: vision-capable model id. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
