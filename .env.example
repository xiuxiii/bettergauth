# ---------------------------------------------------------------------------
# AI provider configuration
#
# Keys are ONLY ever read server-side (in lib/ai/*, all `server-only`) and are
# never exposed to the client. Copy this file to `.env.local` and fill in the
# values for the provider you want.
# ---------------------------------------------------------------------------

# Which provider to use: "mock" (default, no key needed) or "anthropic".
AI_PROVIDER=mock

# --- Required when AI_PROVIDER=anthropic ---
# Your Anthropic API key (starts with sk-ant-...). Server-side only.
# ANTHROPIC_API_KEY=

# --- Optional when AI_PROVIDER=anthropic ---
# Vision-capable model id. Defaults to claude-opus-5 if unset.
# ANTHROPIC_MODEL=claude-opus-5
