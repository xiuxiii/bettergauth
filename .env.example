# AI provider selection. Only "mock" is implemented for now.
# When a real provider is added, set this to e.g. "anthropic" or "openai"
# and supply the corresponding key below. Keys are ONLY ever read
# server-side (in lib/ai/*), never exposed to the client.
AI_PROVIDER=mock

# Example real-provider keys (unused while AI_PROVIDER=mock):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
